# Backend
GROQ_API_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_HOURS=1
DATABASE_URL=postgresql://admin:admin@localhost:5432/interview_prep

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# CORS
# Dev: http://localhost:3000
# Prod (Fly.io + Vercel): https://tu-app.vercel.app
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Entorno: development | production | test
FLASK_ENV=development

# Logging: DEBUG | INFO | WARNING | ERROR (por defecto INFO)
LOG_LEVEL=INFO

# Sentry (opcional): si esta vacia, Sentry no se inicializa.
# Se envian errores sin PII y sin cuerpos de peticion.
SENTRY_DSN=